# CursoPPS — Variables de entorno
# Copia a .env y ajusta

# Puerto expuesto en el host
PORT=8088

# Código de acceso al curso (lo das a los alumnos)
ACCESS_CODE=pps2025

# Clave secreta para firmar sesiones (cámbiala en producción!)
SECRET_KEY=changeme-set-in-production-32chars!

# Duración de sesión en segundos (86400 = 24h)
SESSION_TTL=86400
