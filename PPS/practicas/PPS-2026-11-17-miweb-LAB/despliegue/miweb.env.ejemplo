# Configuración de miweb. Copia este fichero a ~/.config/miweb/miweb.env,
# rellena los valores y déjalo con permisos 600. NUNCA lo subas a Git.
#
# Clave de sesión: genera una con
#   python3 -c "import secrets; print(secrets.token_hex(32))"
MIWEB_SECRET_KEY=
# Contraseña del usuario admin que se crea la primera vez (12 caracteres o más).
MIWEB_ADMIN_CLAVE=
# 1 solo mientras desarrollas. En producción, 0.
MIWEB_DEBUG=0
# Dónde guardar la base de datos y el registro de seguridad (rutas absolutas).
MIWEB_BD=/home/TU_USUARIO/pps/miweb/datos/miweb.db
MIWEB_REGISTRO=/var/log/miweb/seguridad.log
