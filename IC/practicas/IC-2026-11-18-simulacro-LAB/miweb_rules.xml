<!--
  Reglas de miweb (la web de reservas del aula).
  Leen el registro de seguridad /var/log/miweb/seguridad.log, una línea JSON
  por evento. Wazuh lo decodifica con su decodificador json de serie, así que
  los campos del contrato (evento, usuario, ip, ruta, estado, detalle) llegan
  ya separados y no hace falta escribir ningún decodificador.
  Identificadores 100200 a 100299.
-->
<group name="local,miweb,">

  <!-- Raíz: cualquier línea JSON cuyo campo app sea miweb. Nivel 0: no avisa. -->
  <rule id="100200" level="0">
    <decoded_as>json</decoded_as>
    <field name="app">^miweb$</field>
    <description>miweb: evento.</description>
  </rule>

  <!-- Accesos -->
  <rule id="100201" level="5">
    <if_sid>100200</if_sid>
    <field name="evento">^login_fallido$</field>
    <description>miweb: acceso fallido de $(usuario) desde $(ip).</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100202" level="3">
    <if_sid>100200</if_sid>
    <field name="evento">^login_ok$</field>
    <description>miweb: acceso correcto de $(usuario) desde $(ip).</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100203" level="10" frequency="6" timeframe="120">
    <if_matched_sid>100201</if_matched_sid>
    <same_field>ip</same_field>
    <description>miweb: fuerza bruta, 6 accesos fallidos en 2 minutos desde $(ip).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100204" level="12" timeframe="300">
    <if_sid>100202</if_sid>
    <if_matched_sid>100203</if_matched_sid>
    <same_field>ip</same_field>
    <description>miweb: acceso correcto de $(usuario) desde $(ip) después de una fuerza bruta desde esa IP.</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- Base de datos y búsqueda -->
  <rule id="100205" level="0">
    <if_sid>100200</if_sid>
    <field name="evento">^busqueda$</field>
    <description>miweb: búsqueda de $(usuario).</description>
  </rule>

  <rule id="100206" level="7">
    <if_sid>100200</if_sid>
    <field name="evento">^error_bd$</field>
    <description>miweb: error de la base de datos provocado por $(usuario) desde $(ip). Posible inyección SQL.</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <rule id="100207" level="10">
    <if_sid>100205, 100206</if_sid>
    <field name="detalle" type="pcre2">(?i)union\s+(all\s+)?select|'\s*or\s+'?\w+'?\s*=\s*'?\w+|sqlite_master|--\s*$</field>
    <description>miweb: inyección SQL en la búsqueda desde $(ip) (usuario $(usuario)).</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>attack,sql_injection,</group>
  </rule>

  <!-- Autorización -->
  <rule id="100208" level="8">
    <if_sid>100200</if_sid>
    <field name="evento">^reserva_ajena$</field>
    <description>miweb: $(usuario) ha abierto una reserva que no es suya ($(detalle)) desde $(ip).</description>
    <group>access_control,</group>
  </rule>

  <rule id="100209" level="6">
    <if_sid>100200</if_sid>
    <field name="evento">^acceso_denegado$</field>
    <description>miweb: $(usuario) ha intentado entrar en $(ruta) sin permiso desde $(ip).</description>
    <group>access_denied,</group>
  </rule>

  <!-- Enumeración de rutas.
       La 100210 tiene nivel 2 y no 0: una regla de nivel 0 nunca cuenta para
       if_matched_sid, así que la 100211 no saltaría jamás. Con nivel 2 tampoco
       llena el panel, porque Wazuh solo guarda alertas de nivel 3 o más. -->
  <rule id="100210" level="2">
    <if_sid>100200</if_sid>
    <field name="evento">^no_encontrado$</field>
    <description>miweb: página inexistente $(ruta).</description>
  </rule>

  <rule id="100211" level="8" frequency="10" timeframe="60">
    <if_matched_sid>100210</if_matched_sid>
    <same_field>ip</same_field>
    <description>miweb: enumeración de rutas, 10 páginas inexistentes en 1 minuto desde $(ip).</description>
    <mitre>
      <id>T1595.003</id>
    </mitre>
    <group>recon,</group>
  </rule>

  <!-- Altas de cuentas: no es un ataque, pero conviene verlas -->
  <rule id="100212" level="3">
    <if_sid>100200</if_sid>
    <field name="evento">^registro$</field>
    <description>miweb: cuenta nueva $(usuario) creada desde $(ip).</description>
  </rule>

</group>
